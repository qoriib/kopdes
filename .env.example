# ==============================================================================
# SIMKOPDES Environment Variables Template (.env.example)
# Salin berkas ini menjadi '.env' di komputer lokal Anda dan isi nilai kuncinya.
# ==============================================================================

# Kredensial Cloudflare R2 Remote Storage (DVC S3 Protocol)
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key_here

# Kredensial Cloudflare Workers AI API (untuk Stage Interpretasi AI)
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_workers_ai_api_token_here

# Konfigurasi Opsional DVC Remote
DVC_REMOTE_BUCKET=s3://kopdes
